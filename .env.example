# Secret-free local example. Replace example passwords before deployment.
WEB_PORT=80
MYSQL_DATABASE=docker_image_creator
MYSQL_USER=docker_image_creator
MYSQL_PASSWORD=password
MYSQL_ROOT_PASSWORD=root_password
# Match the application account above; URL-encode username/password components.
DATABASE_URL=mysql://docker_image_creator:password@mysql:3306/docker_image_creator
# Generate a private random signing key with at least 32 bytes. No default key exists.
# Example generation command: openssl rand -hex 32
AUTH_ACCESS_TOKEN_SECRET=
# Comma-separated exact origins; add the Vite origin for source development.
AUTH_TRUSTED_ORIGINS=http://127.0.0.1
# Separate AES-256-GCM key for generation inputs, returned output and database secrets.
# Generate 32 random bytes encoded as 64 hexadecimal characters: openssl rand -hex 32
# Supply the full 64-character output; back it up to retain decryptability.
CONFIG_ENCRYPTION_KEY=
# Optional absolute artifact directory. Source default: repository .runtime/configs.
# CONFIG_ARTIFACT_ROOT=/absolute/private/path/configs
# OpenAI-compatible Chat Completions endpoint (e.g. your Modal deployment).
# Use its HTTPS API base including /v1, not /chat/completions.
# Set MODEL to the served model name from your endpoint.
# Server only: API generation and explicitly invoked evaluation in runner.
# Missing/invalid settings fail explicitly when generation/evaluation is called.
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional private directory for redacted config-creation LLM request/response JSON.
# Source default and Docker host bind: repository .runtime/llm.
# Evaluation always writes bodies below its own report directory.
# LLM_LOG_ROOT=/absolute/private/path/llm
# Optional for Docker Desktop/WSL if source edits are not detected.
DEV_WATCH_POLLING=false
# Local Vite proxy target; Docker development sets http://api:3000 automatically.
# API_PROXY_TARGET=http://127.0.0.1:3000
# API-to-runner terminal relay; Compose sets the private service URL automatically.
# Source development only: start the runner separately and select its loopback URL.
# TERMINAL_RUNNER_URL=ws://127.0.0.1:3001/terminal
