generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = "js"
}

datasource db {
  provider = "mysql"
}

model User {
  id                 String              @id @db.Char(36)
  email              String              @unique @db.VarChar(254)
  passwordHash       String              @map("password_hash") @db.VarChar(255)
  createdAt          DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.DateTime(3)
  sessions           Session[]
  configurations     Configuration[]
  runtimeOperations  RuntimeOperation[]
  runtimeReservation RuntimeReservation?

  @@map("users")
}

model Session {
  id            String         @id @db.Char(36)
  userId        String         @map("user_id") @db.Char(36)
  createdAt     DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  expiresAt     DateTime       @map("expires_at") @db.DateTime(3)
  revokedAt     DateTime?      @map("revoked_at") @db.DateTime(3)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]
  terminalTickets TerminalTicket[]

  @@index([userId, expiresAt])
  @@map("sessions")
}

model RefreshToken {
  id        String    @id @db.Char(36)
  sessionId String    @map("session_id") @db.Char(36)
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  usedAt    DateTime? @map("used_at") @db.DateTime(3)
  session   Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("refresh_tokens")
}

enum GenerationStatus {
  queued
  running
  succeeded
  failed
}

model Configuration {
  id                 String              @id @db.Char(36)
  userId             String              @map("user_id") @db.Char(36)
  name               String              @db.VarChar(80)
  description        String              @db.VarChar(500)
  services           Json
  inputVersion       Int                 @default(1) @map("input_version")
  environmentValues  SuppliedEnvironmentValue[]
  requestKey         String              @map("request_key") @db.Char(36)
  inputDigest        String              @map("input_digest") @db.Char(64)
  createdAt          DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  deletionRequestedAt DateTime?           @map("deletion_requested_at") @db.DateTime(3)
  deletedAt          DateTime?           @map("deleted_at") @db.DateTime(3)
  cleanupPending     Boolean             @default(false) @map("cleanup_pending")
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  generations        GenerationAttempt[]
  revisions          ConfigRevision[]
  secrets            ConfigSecret[]
  deployment         Deployment?
  runtimeOperations  RuntimeOperation[]
  runtimeReservation RuntimeReservation?
  runtimePorts       RuntimePort[]
  terminalTickets    TerminalTicket[]

  @@unique([userId, requestKey])
  @@index([userId, deletedAt, createdAt])
  @@index([cleanupPending, deletedAt])
  @@map("configurations")
}

model SuppliedEnvironmentValue {
  id             String        @id @db.Char(36)
  configId       String        @map("config_id") @db.Char(36)
  reference      String        @unique @db.VarChar(43)
  purpose        String        @db.VarChar(500)
  valueEncrypted String        @map("value_encrypted") @db.Text
  config         Configuration @relation(fields: [configId], references: [id], onDelete: Cascade)
  bindings       ServiceEnvironmentBinding[]

  @@unique([id, configId])
  @@index([configId])
  @@map("supplied_environment_values")
}

model ServiceEnvironmentBinding {
  id        String                   @id @db.Char(36)
  configId  String                   @map("config_id") @db.Char(36)
  valueId   String                   @map("value_id") @db.Char(36)
  service   String                   @db.VarChar(30)
  name      String                   @db.VarChar(128)
  value     SuppliedEnvironmentValue @relation(fields: [valueId, configId], references: [id, configId], onDelete: Cascade)

  @@unique([configId, service, name])
  @@index([valueId, configId])
  @@map("service_environment_bindings")
}

model GenerationAttempt {
  id              String           @id @db.Char(36)
  configId        String           @map("config_id") @db.Char(36)
  status          GenerationStatus @default(queued)
  stage           String           @default("queued") @db.VarChar(32)
  inputEncrypted  String           @map("input_encrypted") @db.MediumText
  outputEncrypted String?          @map("output_encrypted") @db.MediumText
  outputTruncated Boolean          @default(false) @map("output_truncated")
  cleanupPending  Boolean          @default(false) @map("cleanup_pending")
  errorCode       String?          @map("error_code") @db.VarChar(32)
  leaseToken      String?          @map("lease_token") @db.Char(36)
  deadlineAt      DateTime?        @map("deadline_at") @db.DateTime(3)
  leaseExpiresAt  DateTime?        @map("lease_expires_at") @db.DateTime(3)
  createdAt       DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  completedAt     DateTime?        @map("completed_at") @db.DateTime(3)
  config          Configuration    @relation(fields: [configId], references: [id], onDelete: Cascade)
  revision        ConfigRevision?

  @@index([status, createdAt])
  @@index([status, leaseExpiresAt])
  @@index([configId])
  @@map("generation_attempts")
}

model ConfigRevision {
  id                String             @id @db.Char(36)
  configId          String             @map("config_id") @db.Char(36)
  generationId      String             @unique @map("generation_id") @db.Char(36)
  version           Int
  spec              Json
  compose           String             @db.MediumText
  digest            String             @db.Char(64)
  artifactPath      String             @map("artifact_path") @db.VarChar(255)
  createdAt         DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  config            Configuration      @relation(fields: [configId], references: [id], onDelete: Cascade)
  generation        GenerationAttempt  @relation(fields: [generationId], references: [id], onDelete: Cascade)
  deployments       Deployment[]
  runtimeOperations RuntimeOperation[]

  @@unique([configId, version])
  @@map("config_revisions")
}

model ConfigSecret {
  id             String        @id @db.Char(36)
  configId       String        @map("config_id") @db.Char(36)
  name           String        @db.VarChar(100)
  valueEncrypted String        @map("value_encrypted") @db.Text
  config         Configuration @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@unique([configId, name])
  @@map("config_secrets")
}

model GenerationSlot {
  id             Int       @id
  generationId   String?   @map("generation_id") @db.Char(36)
  leaseToken     String?   @map("lease_token") @db.Char(36)
  leaseExpiresAt DateTime? @map("lease_expires_at") @db.DateTime(3)

  @@map("generation_slots")
}

enum RuntimeStatus {
  queued
  running
  succeeded
  failed
}

enum RuntimeAction {
  start
  stop
  delete
}

enum DeploymentState {
  starting
  running
  stopping
  stopped
  failed
  unknown
}

model Deployment {
  configId    String          @id @map("config_id") @db.Char(36)
  revisionId  String          @map("revision_id") @db.Char(36)
  operationId String          @map("operation_id") @db.Char(36)
  state       DeploymentState
  manifest    String          @db.MediumText
  digest      String          @db.Char(64)
  observedAt  DateTime?       @map("observed_at") @db.DateTime(3)
  serviceObservations Json?   @map("service_observations")
  config      Configuration   @relation(fields: [configId], references: [id], onDelete: Restrict)
  revision    ConfigRevision  @relation(fields: [revisionId], references: [id], onDelete: Restrict)

  @@map("deployments")
}

model RuntimeOperation {
  id             String         @id @db.Char(36)
  userId         String         @map("user_id") @db.Char(36)
  configId       String         @map("config_id") @db.Char(36)
  revisionId     String         @map("revision_id") @db.Char(36)
  requestKey     String         @map("request_key") @db.Char(36)
  type           RuntimeAction
  status         RuntimeStatus  @default(queued)
  stage          String         @default("queued") @db.VarChar(32)
  errorCode      String?        @map("error_code") @db.VarChar(32)
  cleanupPending Boolean        @default(false) @map("cleanup_pending")
  leaseToken     String?        @map("lease_token") @db.Char(36)
  deadlineAt     DateTime?      @map("deadline_at") @db.DateTime(3)
  leaseExpiresAt DateTime?      @map("lease_expires_at") @db.DateTime(3)
  createdAt      DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  completedAt    DateTime?      @map("completed_at") @db.DateTime(3)
  user           User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  config         Configuration  @relation(fields: [configId], references: [id], onDelete: Restrict)
  revision       ConfigRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)

  @@unique([userId, requestKey])
  @@index([status, createdAt])
  @@index([configId, status])
  @@map("runtime_operations")
}

model RuntimeReservation {
  userId   String        @id @map("user_id") @db.Char(36)
  configId String        @unique @map("config_id") @db.Char(36)
  user     User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  config   Configuration @relation(fields: [configId], references: [id], onDelete: Restrict)

  @@map("runtime_reservations")
}

model RuntimePort {
  port     Int           @id
  configId String        @map("config_id") @db.Char(36)
  config   Configuration @relation(fields: [configId], references: [id], onDelete: Restrict)

  @@index([configId])
  @@map("runtime_ports")
}

model TerminalTicket {
  id          String        @id @db.Char(36)
  tokenHash   String        @unique @map("token_hash") @db.Char(64)
  sessionId   String        @map("session_id") @db.Char(36)
  userId      String        @map("user_id") @db.Char(36)
  configId    String        @map("config_id") @db.Char(36)
  revisionId  String        @map("revision_id") @db.Char(36)
  operationId String        @map("operation_id") @db.Char(36)
  service     String        @db.VarChar(40)
  expiresAt   DateTime      @map("expires_at") @db.DateTime(3)
  usedAt      DateTime?     @map("used_at") @db.DateTime(3)
  session     Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  config      Configuration @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("terminal_tickets")
}
