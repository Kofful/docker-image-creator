{
  "name": "docker-image-creator",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.23.4 <23"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint apps packages/contracts",
    "test": "pnpm test:compose-contract && pnpm test:compose-provider && pnpm test:web && pnpm test:api",
    "test:compose-provider": "pnpm --filter @docker-image-creator/api test:compose-provider",
    "test:compose-contract": "pnpm --filter @docker-image-creator/api test:compose-contract",
    "test:web": "pnpm --filter @docker-image-creator/web test",
    "test:api": "pnpm --filter @docker-image-creator/api test",
    "test:runtime": "pnpm --filter @docker-image-creator/api test:runtime",
    "test:dev": "node infra/scripts/test-dev.mjs",
    "format": "prettier --write package.json pnpm-workspace.yaml tsconfig.base.json eslint.config.mjs apps packages infra docs",
    "format:check": "prettier --check package.json pnpm-workspace.yaml tsconfig.base.json eslint.config.mjs apps packages infra docs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "22.9.0",
    "eslint": "9.39.1",
    "eslint-plugin-vue": "10.7.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.0"
  }
}
